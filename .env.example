# Environment variables template for DailyNotes
# Copy this file to .env and configure appropriate values for your environment.

# PostgreSQL Database (Docker)
POSTGRES_PASSWORD=password
POSTGRES_USER=postgres
POSTGRES_DB=DailyNotes

# Database Connection String for DailyNotes API & Import Tool (Local Dev)
ConnectionStrings__DefaultConnection=Host=localhost;Database=DailyNotes;Username=postgres;Password=password

# JWT Settings (Minimum 32 characters for HMAC-SHA256 signing)
JWT_KEY=YourSuperSecretKeyForLocalDevelopment123!
Jwt__Key=YourSuperSecretKeyForLocalDevelopment123!

# Import Tool Default User Password
IMPORT_USER_PASSWORD=Password123!
